#include<bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<long long>;
using vs = vector<string>;
using si = set<int>;
using sll = set<long long>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {

        int n;
        cin>>n;

        string a,b;
        cin>>a>>b;

        ll even1=0,odd1=0;
        ll even2=0,odd2=0;
        for(int i=0;i<n;i++)
        {

            if(i%2==0)
            {
                if(a[i]=='1')
                {
                    even1++;
                }
                if(b[i]=='1')
                {
                    even2++;
                }

            }
            else
            {
                if(a[i]=='1')
                {
                    odd1++;
                }
                if(b[i]=='1')
                {
                    odd2++;
                }


            }
        }

        if(even1==even2 && odd1==odd2)
        {
            cout<<"YES"<<nl;
        }
        else
        {
            cout<<"NO"<<nl;
        }







    }

}
