#include<bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<long long>;
using vs = vector<string>;
using si = set<int>;
using sll = set<long long>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {

        int n;
        cin>>n;

        string a,b;
        cin>>a>>b;

        ll cnt1=0;
        ll cnt2=0;
        ll even1=0,even2=0;
        ll odd1=0,odd2=0;
        vll a1,a2,b1,b2;
        for(int i=0;i<n;i++)
        {

            if(a[i]=='1')
            {
                cnt1++;
                if(i%2==0)
                {
                    even1++;
                    a1.push_back(i);
                }
                else
                {
                    odd1++;
                    a2.push_back(i);
                }

            }

            if(b[i]=='1')
            {
                cnt2++;
                if(i%2==0)
                {
                    even2++;
                    b1.push_back(i);
                }
                else
                {
                    odd2++;
                    b2.push_back(i);
                }

            }

        }

        if(cnt1!=cnt2 || even1!=even2 || odd1!=odd2)
        {
            cout<<-1<<nl;
            continue;
        }
        ll ans=0;
        for(int i=0;i<even1;i++)
        {
            ans+=abs(a1[i]-b1[i])/2;
        }
        for(int i=0;i<odd1;i++)
        {
            ans+=abs(a2[i]-b2[i])/2;
        }
        cout<<ans<<nl;






    }

}
