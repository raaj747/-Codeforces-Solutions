#include<bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<long long>;
using vs = vector<string>;
using si = set<int>;
using sll = set<long long>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;

        string s;
        cin>>s;

        int cnt=1;
        for(int i=1;i<n;i++)
        {
            if(s[i]!=s[i-1])
            {
                cnt++;
            }


        }
        int ans=cnt;
        for(int i=1;i<n-1;i++)
        {

            int a=cnt;
            if(s[i-1]!=s[i] && s[i]!=s[i+1])
            {

                if(s[i-1]==s[i+1])
                {
                    a=cnt-2;
                }
                else
                {
                    a=cnt-1;
                }

            }
            if(a<ans)
            {
                ans=a;
            }


        }
        cout<<ans<<nl;







    }

}
