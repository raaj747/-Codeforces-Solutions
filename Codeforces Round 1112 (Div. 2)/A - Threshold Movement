#include<bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<long long>;
using vs = vector<string>;
using si = set<int>;
using sll = set<long long>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {

        int n;
        cin>>n;

        vi a(n+1);
        int even=0;
        int odd=INT_MAX;
        for(int i=1;i<=n;i++)
        {
            cin>>a[i];
            if(i%2==0)
            {
                if(a[i]>even)
                    even=a[i];
            }
            else
            {
                if(a[i]<odd)
                    odd=a[i];
            }
        }

        if(n%2==1)
        {
            cout<<"NO"<<nl;
        }
        else if(even<odd-1)
        {
            cout<<"YES"<<nl;
        }
        else
        {
            cout<<"NO"<<nl;
        }



    }

}
