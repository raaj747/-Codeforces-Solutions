#include <bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<ll>;
using vs = vector<string>;
using si = set<int>;
using sll = set<ll>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        ll x,y,k;
        cin>>x>>y>>k;

        ll d=y-x;
        ll ans=0;
        while(k>0 && x<=d)
        {
            ans+=d%x;
            x++;
            k--;
        }
        ans+=k*d;
        cout<<ans<<nl;




    }

}
