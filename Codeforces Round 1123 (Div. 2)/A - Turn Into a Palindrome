import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int t = input.nextInt();
        while (t-- > 0) {
            int n = input.nextInt();
            char c = input.next().charAt(0);
            String s = input.next();

            int ans = 0;
            for (int i = 0; i < n / 2; i++) {
                int j = n - i - 1;
                if (s.charAt(i) == s.charAt(j)) {
                    continue;
                }
                else if (s.charAt(i) == c || s.charAt(j) == c) {
                    ans += 1;
                }
                else {
                    ans += 2;
                }
            }
            System.out.println(ans);

        }
    }
}
