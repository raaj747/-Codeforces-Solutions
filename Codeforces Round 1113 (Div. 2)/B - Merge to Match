#include<bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<long long>;
using vs = vector<string>;
using si = set<int>;
using sll = set<long long>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {

        int n,m;
        cin>>n>>m;

        vll a(n),b(m);
        for(int i=0;i<n;i++)
        {
            cin>>a[i];
        }
        for(int i=0;i<m;i++)
        {
            cin>>b[i];
        }

        sort(a.begin(), a.end());
        sort(b.begin(), b.end());

        if(n<2*m)
        {
            cout<<"NO"<<nl;
            continue;
        }

        bool ok=true;
        for(int i=0;i<m;i++)
        {
            ll low=lower_bound(a.begin(),a.end(),b[i])-a.begin();
            ll hi=n-low;

            if(low<i+1 || hi<m-i)
            {
               ok=false;
               break;
            }

        }

        if(ok)
        {
            cout<<"YES"<<nl;
        }
        else
        {
            cout<<"NO"<<nl;
        }



    }

}
