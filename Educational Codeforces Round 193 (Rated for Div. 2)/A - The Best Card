 #include<bits/stdc++.h>
 using namespace std;

 typedef long long ll;
 const char nl = '\n';
 using vi = vector<int>;
 using vll = vector<long long>;
 using vs = vector<string>;
 using si = set<int>;
 using sll = set<long long>;
 using st = stack<int>;

 int main()
 {
     int t;
     cin>>t;
     while(t--)
     {

        ll n;
        cin>>n;

        ll a=n+1;
        bool ok=true;
        for(ll i=2;i*i<=a;i++)
        {
            if(a%i==0)
            {
                ok=false;
                break;
            }

        }

        if(ok)
        {
            cout<<"YES"<<nl;
        }
        else
        {
            cout<<"NO"<<nl;
        }






     }

 }
