#include <bits/stdc++.h>
using namespace std;

typedef long long ll;
const char nl = '\n';
using vi = vector<int>;
using vll = vector<ll>;
using vs = vector<string>;
using si = set<int>;
using sll = set<ll>;
using st = stack<int>;

int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        int n;
        cin>>n;

        string s;
        cin>>s;

        int ans=0;
        for(int i=0;i<4;i++)
        {
            int a=i/2;
            int b=i%2;
            bool ok=true;
            for(int j=0;j<n;j++)
            {
                int cnt;
                if(j==0)
                {
                    cnt=a;
                }
                else if(j==1)
                {
                    cnt=b;
                }
                else
                {
                    if(j%2==0)
                    {
                        cnt=a;
                    }
                    else
                    {
                        cnt=b;
                    }

                    if((j/2)%2==1)
                    {
                        cnt=1-cnt;
                    }
                }

                if(s[j]!='?' && s[j]-'0'!=cnt)
                {
                    ok=false;
                    break;
                }



            }
            if(ok)
            {
                ans++;
            }


        }
        cout<<ans<<nl;




    }




}
